{
	"nodes":[
		{"id":"group-admin","type":"group","x":1000,"y":-1000,"width":1940,"height":1320,"color":"5","label":"Admin Workflow"},
		{"id":"group-overall","type":"group","x":-1360,"y":-1000,"width":2280,"height":1030,"color":"1","label":"Overall Application Flow"},
		{"id":"group-evaluation","type":"group","x":960,"y":490,"width":2500,"height":660,"color":"6","label":"Result Evaluation Flow"},
		{"id":"group-student","type":"group","x":-920,"y":840,"width":1620,"height":780,"color":"4","label":"Student Workflow"},
		{"id":"group-auth","type":"group","x":-920,"y":240,"width":1620,"height":500,"color":"3","label":"Backend Auth And Authorization Flow"},
		{"id":"auth-express","type":"text","text":"Express Auth Service\n\nFind/create user, hash/check password, or verify Firebase ID token.","x":-80,"y":340,"width":310,"height":140,"color":"3"},
		{"id":"auth-protected","type":"text","text":"Protected Requests\n\n`authenticateToken` verifies JWT and loads the user.","x":-290,"y":580,"width":300,"height":120,"color":"3"},
		{"id":"auth-cookie","type":"text","text":"JWT Cookie\n\nExpress sets `quizforge_token` and returns the user object.","x":380,"y":351,"width":280,"height":120,"color":"3"},
		{"id":"student-dashboard","type":"text","text":"Student Dashboard\n\nLoad active public and private quizzes.","x":-860,"y":960,"width":260,"height":110,"color":"4"},
		{"id":"student-submit","type":"text","text":"Submit Quiz\n\nManual submit or timer expiry sends `POST /api/quizzes/:quizId/submit`.","x":-700,"y":1200,"width":320,"height":130,"color":"4"},
		{"id":"student-details","type":"text","text":"Quiz Details\n\nStudent selects a quiz and opens details.","x":-500,"y":960,"width":260,"height":110,"color":"4"},
		{"id":"student-grade","type":"text","text":"Backend Grading\n\nValidate timer.\n\nAuto-grade objective answers.\n\nMark subjective answers pending.","x":-260,"y":1180,"width":320,"height":170,"color":"6"},
		{"id":"admin-create","type":"text","text":"Create Quiz\n\nEnter title, description, duration, and visibility.","x":1500,"y":-950,"width":300,"height":120,"color":"5"},
		{"id":"admin-dashboard","type":"text","text":"Admin Dashboard\n\nChoose quiz, question, publishing, result, or delete actions.","x":1080,"y":-880,"width":300,"height":130,"color":"5"},
		{"id":"auth-admin-check","type":"text","text":"Admin Routes\n\n`authorizeAdminRole` allows admin APIs or returns `401/403`.","x":280,"y":580,"width":300,"height":120,"color":"5"},
		{"id":"auth-method","type":"text","text":"Auth Method\n\nEmail/password goes directly to Express.\n\nGoogle OAuth goes through Firebase first.","x":-520,"y":318,"width":300,"height":185,"color":"3"},
		{"id":"auth-click","type":"text","text":"Browser / React\n\nUser clicks login or register.","x":-860,"y":356,"width":240,"height":110,"color":"3"},
		{"id":"student-attempt","type":"text","text":"Timed Attempt\n\n`GET /api/quizzes/:quizId/attempt`\n\nAnswer MCQ, true/false, short integer, or short subjective questions.","x":320,"y":930,"width":340,"height":170,"color":"4"},
		{"id":"student-access","type":"text","text":"Access Check\n\nPublic quizzes start directly.\n\nPrivate quizzes require `POST /api/quizzes/:quizId/start` with access token.","x":-140,"y":930,"width":340,"height":190,"color":"4"},
		{"id":"admin-publish","type":"text","text":"Publish State\n\nPublish, unpublish, or keep as draft/unpublished.","x":1500,"y":-410,"width":300,"height":120,"color":"5"},
		{"id":"admin-questions","type":"text","text":"Manage Questions\n\nAdd MCQ, true/false, short integer, or short subjective questions.","x":1920,"y":-680,"width":330,"height":130,"color":"5"},
		{"id":"admin-store","type":"text","text":"Store Quiz\n\nSave quiz metadata in Firestore, then move to question management.","x":2340,"y":-940,"width":300,"height":130,"color":"5"},
		{"id":"admin-save-question","type":"text","text":"Save Question\n\n`POST /api/admin/quizzes/:quizId/questions`\n\nRepeat until the quiz is ready.","x":2600,"y":-680,"width":320,"height":210,"color":"5"},
		{"id":"admin-evaluate","type":"text","text":"Manual Evaluation\n\nMark correct/incorrect, assign points, and save with `POST /api/admin/results/:resultId/evaluate`.","x":2500,"y":-175,"width":330,"height":170,"color":"6"},
		{"id":"admin-token","type":"text","text":"Private Quiz Token\n\nFor private quizzes, enter access token. Backend encrypts it before storage.","x":1920,"y":-1080,"width":330,"height":140,"color":"5"},
		{"id":"admin-results","type":"text","text":"View Results\n\nOpen quiz submissions and final scores.","x":1080,"y":110,"width":365,"height":110,"color":"5"},
		{"id":"student-result","type":"text","text":"Result Page\n\nShow final score, breakdown, or pending evaluation notice.","x":190,"y":1200,"width":300,"height":130,"color":"4"},
		{"id":"student-followups","type":"text","text":"Student Follow-ups\n\nLeaderboard, attempt history, and student stats can return the student to dashboard.","x":-280,"y":1430,"width":360,"height":130,"color":"4"},
		{"id":"admin-edit","type":"text","text":"Edit Quiz\n\nUpdate metadata with `PUT /api/admin/quizzes/:quizId`.","x":1860,"y":-530,"width":300,"height":120,"color":"5"},
		{"id":"admin-delete","type":"text","text":"Delete Quiz\n\nConfirm delete, then call `DELETE /api/admin/quizzes/:quizId`.","x":1530,"y":-210,"width":330,"height":120,"color":"5"},
		{"id":"admin-pending","type":"text","text":"Pending Evaluation Queue\n\nReview subjective answers against the question and expected answer/rubric.","x":2035,"y":110,"width":350,"height":150,"color":"6"},
		{"id":"eval-auto","type":"text","text":"Objective Answers\n\nMCQ: compare option index.\n\nTrue/false: compare boolean.\n\nShort integer: normalize and compare number.","x":1880,"y":505,"width":350,"height":190,"color":"6"},
		{"id":"eval-pending","type":"text","text":"Subjective Answers\n\nMark pending manual evaluation.","x":1880,"y":820,"width":350,"height":110,"color":"6"},
		{"id":"eval-store","type":"text","text":"Store Result\n\nSave score and answer breakdown in Firestore.","x":2350,"y":675,"width":310,"height":120,"color":"6"},
		{"id":"eval-final","type":"text","text":"Final Result\n\nNo pending subjective answers, or admin has updated all pending answers.","x":2760,"y":865,"width":310,"height":130,"color":"6"},
		{"id":"eval-submit","type":"text","text":"Student Submits Quiz\n\nLoad quiz and questions.","x":1020,"y":675,"width":270,"height":110,"color":"6"},
		{"id":"eval-each","type":"text","text":"Process Each Answer\n\nCheck question type and normalize submitted answer when needed.","x":1430,"y":665,"width":310,"height":130,"color":"6"},
		{"id":"overall-firebase","type":"text","text":"Google OAuth\n\nFirebase verifies identity and returns an ID token to the frontend.","x":20,"y":-705,"width":300,"height":130,"color":"3"},
		{"id":"overall-backend-auth","type":"text","text":"Backend Auth API\n\n`POST /api/auth/register`\n`POST /api/auth/login`\n`POST /api/auth/google`","x":60,"y":-985,"width":300,"height":140,"color":"3"},
		{"id":"overall-user-record","type":"text","text":"Firestore User\n\nCreate or load saved app user and role.","x":540,"y":-975,"width":280,"height":120,"color":"3"},
		{"id":"overall-token","type":"text","text":"Issue Session\n\nGenerate app JWT and set HTTP-only `quizforge_token` cookie.","x":540,"y":-665,"width":280,"height":130,"color":"3"},
		{"id":"overall-visitor","type":"text","text":"Visitor opens QuizForge\n\nLanding page presents login/register choices.","x":-1320,"y":-560,"width":260,"height":120,"color":"1"},
		{"id":"overall-register","type":"text","text":"Register\n\nChoose role: `student` or `admin`.\n\nEmail/password or Google OAuth.","x":-740,"y":-855,"width":300,"height":150,"color":"1"},
		{"id":"604eb23dbdc8e21d","type":"text","text":"JWT Token\n\nToken Verification route\nIf the Token already exist in the user's broswer.","x":-740,"y":-600,"width":300,"height":142,"color":"1"},
		{"id":"overall-login","type":"text","text":"Login\n\nEmail/password or Google OAuth.\n\nGoogle login only works for existing Firestore users.","x":-740,"y":-350,"width":300,"height":150,"color":"1"},
		{"id":"overall-admin-route","type":"text","text":"Admin Role\n\nRedirect to admin dashboard.","x":620,"y":-200,"width":260,"height":120,"color":"5"},
		{"id":"5d59c050edcfe4ee","type":"text","text":"Give the Access control to the respective role.","x":210,"y":-542,"width":300,"height":84,"color":"3"},
		{"id":"overall-student-route","type":"text","text":"Student Role\n\nRedirect to student dashboard.","x":210,"y":-200,"width":260,"height":120,"color":"4"}
